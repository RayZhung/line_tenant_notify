# ==============================================================================
# ISO27001 資安規範環境變數範本 (.env.example)
# 請複製本檔案為 .env 並填入實際機密值。切勿將 .env 提交至 Git 儲存庫！
# ==============================================================================

# [LINE Messaging API Configuration]
# 請至 LINE Developers Console 獲取 Channel Secret 與 Long-lived Channel Access Token
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# [Module Trigger Security]
# 模組一 (爬蟲) 喚醒 模組二 (Vercel Serverless) 時所攜帶的自訂驗證密鑰 (Bearer Token 或 X-Trigger-Token)
NOTIFY_TRIGGER_SECRET=generate_a_secure_random_trigger_secret_here

# [Google Sheets API Configuration]
# 目標試算表 ID (從試算表 URL 中擷取: /spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here
# 工作表名稱
SHEET_NAME_DATA=場站營運數據
SHEET_NAME_TENANTS=多租戶權限表

# Google 服務帳戶金鑰 (二選一設定):
# 方式 A (本機/Ubuntu): 服務帳戶 JSON 檔案路徑
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# 方式 B (Vercel Serverless 雲端部署推薦): 將 service_account.json 內容轉為 Base64 字串存入環境變數
GOOGLE_SERVICE_ACCOUNT_BASE64=

# [System Configuration]
# 預設警戒閥值 (若試算表中未定義時的備用預設值)
DEFAULT_ALERT_THRESHOLD=10.0
# 服務運行環境 (production / development)
ENVIRONMENT=production
